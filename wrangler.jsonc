        "name": "ROOMS",
        "class_name": "GameRoom",
        "script_name": "monopoly-rooms"
      },
      {
        "name": "TRAFFIC",
        "class_name": "TrafficGuard",
        "script_name": "monopoly-rooms"
      }
    ]
  }
}
