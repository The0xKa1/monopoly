{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "monopoly-rooms",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "GameRoom"
      },
      {
        "name": "TRAFFIC",
        "class_name": "TrafficGuard"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameRoom",
        "TrafficGuard"
      ]
    }
  ]
}
